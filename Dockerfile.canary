FROM mcr.microsoft.com/playwright:v1.55.1-noble

WORKDIR /app
ENV NODE_ENV=production

COPY package.json package-lock.json ./
RUN npm ci --omit=dev

COPY src/ppomppu-playwright-canary.js ./src/ppomppu-playwright-canary.js
COPY scripts/ppomppu-playwright-canary.js ./scripts/ppomppu-playwright-canary.js
COPY scripts/ppomppu-render-canary-service.js ./scripts/ppomppu-render-canary-service.js

CMD ["node", "scripts/ppomppu-render-canary-service.js"]

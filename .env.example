# Existing runtime configuration
DATABASE_URL=
# Required in production when admin sessions are enabled. Use at least 32
# random characters and keep it stable across restarts/instances.
ADMIN_SESSION_SECRET=
RSS_FEED_URL=https://www.ppomppu.co.kr/rss.php?id=ppomppu
RSS_FEED_SOURCE=ppomppu
RSS_POLL_INTERVAL_MS=600000
# Defaults to three polling intervals (30 minutes with the interval above).
RSS_FRESHNESS_THRESHOLD_MS=1800000

# Optional Cloudflare R2 image storage.
# Image uploading stays disabled unless ALL five values are present.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# Server-side backfill can be disabled where the source blocks the host IP.
# RSS collection remains active; the one-shot local worker runs separately.
IMAGE_BACKFILL_ENABLED=true
# Local one-shot safety limits (accepted ranges: 1-15 and 5000-60000).
IMAGE_BACKFILL_LIMIT=15
IMAGE_REQUEST_INTERVAL_MS=5000

# Naver Shopping Search API (remote image URL only; no R2 copy/transform)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Coupang Partners official Open API. Keep disabled until final approval and key issuance.
# The collector starts only when the flag and both credentials are present.
COUPANG_PRODUCTS_ENABLED=false
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
# Default: 6 hours. Allowed range: 10 minutes to 24 hours.
COUPANG_POLL_INTERVAL_MS=21600000
# Individual official API request timeout. Allowed range: 1-30 seconds.
COUPANG_REQUEST_TIMEOUT_MS=10000
# Optional comma-separated official category IDs. Defaults to food, kitchen,
# household, digital/appliances, health, and pet supplies.
COUPANG_CATEGORY_IDS=1012,1013,1014,1016,1024,1029

# 토스 승인과 자격정보 발급 및 배포 환경의 고정 outbound IP 등록 전까지 OFF로 유지합니다.
TOSS_SHARELINK_ENABLED=false
TOSS_SHARELINK_CLIENT_ID=
TOSS_SHARELINK_CLIENT_SECRET=
TOSS_SHARELINK_PUBLISHER_ID=
# Default/minimum: 1 hour. Allowed range: 1-24 hours.
TOSS_SHARELINK_POLL_INTERVAL_MS=3600000
# Allowed range: 1-30 seconds. At most 10 public recommendations are stored.
TOSS_SHARELINK_REQUEST_TIMEOUT_MS=10000
TOSS_SHARELINK_MAX_ITEMS=10
